<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_bg"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vault"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/chrome_text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Password-locked notes. AES-256 on this device only."
            android:textSize="13sp"
            android:textColor="@color/chrome_hint" />

        <LinearLayout
            android:id="@+id/vaultLock"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <EditText
                android:id="@+id/vaultPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_bg"
                android:hint="Vault password"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/chrome_text"
                android:textColorHint="@color/chrome_hint"
                android:textSize="15sp" />

            <Button
                android:id="@+id/vaultUnlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Unlock" />

            <Button
                android:id="@+id/vaultSetup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Set password (new vault)" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/vaultMain"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <Button
                android:id="@+id/vaultAdd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="+ New note" />

            <LinearLayout
                android:id="@+id/vaultList"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <Button
                android:id="@+id/vaultLockBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Lock vault" />
        </LinearLayout>

        <TextView
            android:id="@+id/vaultMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp"
            android:textColor="@color/chrome_hint" />
    </LinearLayout>
</ScrollView>
