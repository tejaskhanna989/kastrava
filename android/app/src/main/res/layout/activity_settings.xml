<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/chrome_bg"
    android:padding="20dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_engine"
            android:textStyle="bold"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/engineGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/etCustomEngine"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="@string/set_custom_engine_hint"
            android:inputType="textUri"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_hint"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_appearance"
            android:textStyle="bold"
            android:textSize="16sp" />

        <RadioGroup
            android:id="@+id/themeGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <RadioButton android:id="@+id/themeSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lang_system" />
            <RadioButton android:id="@+id/themeLight" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_light" />
            <RadioButton android:id="@+id/themeDark" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_dark" />
        </RadioGroup>

        <TextView
            android:id="@+id/langLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/language"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/langGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/langSystem" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lang_system" />
            <RadioButton android:id="@+id/langEn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lang_english" />
            <RadioButton android:id="@+id/langRu" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/lang_russian" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbQuick"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_show_quick" />

        <CheckBox
            android:id="@+id/cbBookmarks"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_enable_bm" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_tiles"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgTiles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/tiles4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4" />
            <RadioButton android:id="@+id/tiles8" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8" />
            <RadioButton android:id="@+id/tiles12" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_content"
            android:textStyle="bold"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbBlockers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_blockers" />

        <CheckBox
            android:id="@+id/cbJs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_js" />

        <CheckBox
            android:id="@+id/cbImages"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_images" />

        <CheckBox
            android:id="@+id/cbDesktop"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_desktop" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_privacy"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_cookies"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgCookies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <RadioButton android:id="@+id/cookieBlock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_cookie_block" />
            <RadioButton android:id="@+id/cookieThird" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_cookie_third" />
            <RadioButton android:id="@+id/cookieAllow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_cookie_allow" />
        </RadioGroup>

        <CheckBox
            android:id="@+id/cbSafe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_safe" />

        <CheckBox
            android:id="@+id/cbMixed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_insecure" />

        <CheckBox
            android:id="@+id/cbGeo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_location" />

        <CheckBox
            android:id="@+id/cbFile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_localfiles" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_tabs_bar"
            android:textStyle="bold"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbRestore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_restore" />

        <CheckBox
            android:id="@+id/cbHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_keep_session" />

        <CheckBox
            android:id="@+id/cbConfirmClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_confirm_close" />

        <CheckBox
            android:id="@+id/cbFullUrls"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_full_urls" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_tab_limit"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/rgMaxTabs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <RadioButton android:id="@+id/maxNone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/set_no_limit" />
            <RadioButton android:id="@+id/max20" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="20" />
            <RadioButton android:id="@+id/max50" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="50" />
            <RadioButton android:id="@+id/max100" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/m_textsize"
            android:textStyle="bold"
            android:textSize="16sp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/sbTextZoom"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="50"
                android:max="200" />

            <TextView
                android:id="@+id/tvTextZoom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="48dp"
                android:gravity="end"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_page_font"
            android:textSize="14sp" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical">

            <SeekBar
                android:id="@+id/sbFontSize"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:min="12"
                android:max="24" />

            <TextView
                android:id="@+id/tvFontSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:minWidth="48dp"
                android:gravity="end"
                android:textSize="14sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/lang_system"
            android:textStyle="bold"
            android:textSize="16sp" />

        <CheckBox
            android:id="@+id/cbBattery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_battery" />

        <CheckBox
            android:id="@+id/cbHw"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/set_hwaccel" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_browsing_data"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnClearData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_delete_now" />

        <Button
            android:id="@+id/btnResetSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_reset" />

        <TextView
            android:id="@+id/tvAboutVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/updateSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/set_updates"
                android:textStyle="bold"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvUpdateStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnCheckUpdates"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/set_check_updates" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_account"
            android:textStyle="bold"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvAccountStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etAccountEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="@string/hint_email"
            android:inputType="textEmailAddress"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etAccountPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="@string/hint_password"
            android:inputType="textPassword"
            android:maxLines="1"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_hint"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/etEmailCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="@string/hint_email_code"
            android:inputType="number"
            android:maxLines="1"
            android:maxLength="6"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_hint"
            android:textSize="15sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/etAccountTotp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/field_bg"
            android:hint="@string/hint_2fa"
            android:inputType="number"
            android:maxLines="1"
            android:maxLength="6"
            android:singleLine="true"
            android:importantForAutofill="no"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:textColor="@color/chrome_text"
            android:textColorHint="@color/chrome_hint"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btnAccountGo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_login" />

            <Button
                android:id="@+id/btnAccountOut"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_logout" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnSyncNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/btn_sync_now" />

        <Button
            android:id="@+id/btnAdvanced"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/set_advanced" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/set_data_note"
            android:textSize="13sp" />
    </LinearLayout>
</ScrollView>
