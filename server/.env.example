# Kastrava license server — copy to server/.env and edit
# Razorpay (real mode). Leave unset for DEV mode (fake orders, any signature).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Legacy notes below kept for history; pricing now lives in PLANS in
# dashboard (period daily, interval 34) and cache it in data/plan.json
# as {"plan_id":"plan_xxx"}
RAZORPAY_PLAN_ID=

# Webhook secret — set the same value in the Razorpay dashboard webhook
# pointing to https://<your-host>/api/webhook (subscription.charged etc.)
RAZORPAY_WEBHOOK_SECRET=

# Public base URL (what the app + site call). Use your VPS host: https://kastrava.example.com
KAS_HOST=http://127.0.0.1:8787

# Port + pricing (subscription is PRICE_INR per 34-day cycle; plan interval 34)
# BIND_HOST: interface to bind — 127.0.0.1 (nginx reverse proxy) or 0.0.0.0 (bare public)
PORT=8787
BIND_HOST=127.0.0.1
PRICE_INR=199

# Days past period end before access is revoked (grace period)
GRACE_DAYS=3

# Legacy fallback lifetime in years for old one-time keys
LICENSE_YEARS=10

# Absolute path to the premium installer package served after payment (e.g. /srv/kastrava-premium.deb)
PREMIUM_BUILD=

# Admin token used by `node server/admin.js` (keep long + random)
ADMIN_TOKEN=

# Where orders/licenses are stored (gitignored)
DATA_DIR=./data